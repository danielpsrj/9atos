{
  "name": "9atos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint && prettier --check .",
    "format": "prettier --write .",
    "test": "bash scripts/test-db.sh",
    "test:watch": "vitest",
    "test:coverage": "bash scripts/test-db.sh --coverage",
    "test:db:up": "docker compose --profile test up -d db-test",
    "test:db:down": "docker compose --profile test down -v --remove-orphans",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@prisma/client": "^6.19.3",
    "date-fns": "^4.4.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
